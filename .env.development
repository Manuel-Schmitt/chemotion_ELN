SFTP_HOST=sftp
SFTP_PORT=22
SFTP_UPLOAD_FOLDER=uploads
SFTP_USER=sftp_test
SFTP_PASSWORD=sftp_test

#MESSAGE_ENABLE=false
#MESSAGE_AUTO_INTERNAL=6000
#MESSAGE_IDLE_TIME=12

# JWT key for novnc target encryption
NOVNC_SECRET='secret'

# One time password secret key for 2FA (attr_encrypted uses aes-256-gcm, which
# requires a key of at least 32 bytes)
OTP_SECRET_KEY='change-this-to-a-random-32-byte-or-longer-secret'

# Allow unconfirmed email: leave blank for always, or set a number of days (integer);
# also set 0 to have email being confirmed before first sign in.
DEVISE_ALLOW_UNCONFIRMED=''

# Disable sign up page: leave blank to allow sign up page. set to 'true' to disable it.
# only amdin can then create user accounts.
DEVISE_DISABLED_SIGN_UP=''

# Any new account to be inactive by default => only admin can (de)activate
DEVISE_NEW_ACCOUNT_INACTIVE=false

# LDAP/AD membership check, run synchronously before a disabled Person account is
# persisted: members are activated; non-members, and registrations where the directory is
# unreachable, are rejected (never created). Nested group membership is always resolved (via
# AD's LDAP_MATCHING_RULE_IN_CHAIN), so LDAP_ACTIVATION_GROUP_DN can be a parent group.
# Leave LDAP_HOST/LDAP_BASE/LDAP_ACTIVATION_GROUP_DN blank to disable the check.
#LDAP_HOST=ldap.example.org
#LDAP_PORT=389
#LDAP_BASE=dc=example,dc=org
#LDAP_BIND_DN=cn=service,dc=example,dc=org
#LDAP_BIND_PASSWORD=service-secret
#LDAP_ENCRYPTION_METHOD=plain
#LDAP_UID_ATTRIBUTE=sAMAccountName
#LDAP_ACCOUNT_ATTRIBUTE=name_abbreviation
#LDAP_ACTIVATION_GROUP_DN=cn=eln-users,ou=groups,dc=example,dc=org

# Application's title
APPLICATION_TITLE='Chemotion dev'

DATA_CITE_BASE_URI=https://api.test.datacite.org
DATA_CITE_PREFIX=prefix
DATA_CITE_API_USERNAME=username
DATA_CITE_API_PASSWORD=password
DATA_CITE_DEVICE_PREFIX=DEVICE-
DATA_CITE_RESEARCH_PLAN_PREFIX=RP-
DATA_CITE_DEVICE_PUBLISHER=chemotion.net
DATA_CITE_DEVICE_CREATOR=chemotion.net

# calculate disk usage
CRON_CONFIG_DISK_USAGE='0 0 * * *'

